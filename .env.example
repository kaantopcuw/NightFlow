# =============================================================================
# NightFlow - local Docker Compose configuration
#
#   cp .env.example .env
#
# Every value below has a working default baked into docker-compose.yml, so the
# stack starts without a .env file at all. Copy this file when you want to
# change ports, credentials or enable the observability profile.
#
# These are DEVELOPMENT placeholders. Do not reuse them anywhere else.
# =============================================================================

# --- image naming -------------------------------------------------------------
IMAGE_PREFIX=nightflow
IMAGE_TAG=local

# --- secrets (placeholders - replace before any non-local use) ----------------
JWT_SECRET=dev-only-jwt-secret-change-in-production-min-64-chars-long-000000
INTERNAL_SECRET=dev-internal-secret-change-in-production

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
# Change if 5432 is already taken on your machine.
POSTGRES_PUBLISHED_PORT=5432

# --- MongoDB / Redis / Kafka published ports ----------------------------------
MONGODB_PUBLISHED_PORT=27017
REDIS_PUBLISHED_PORT=6379
KAFKA_PUBLISHED_PORT=9092

# --- notification-service SMTP ------------------------------------------------
# Leave as-is unless you actually want mail delivery; the service only connects
# when it consumes an order event.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=password

# --- observability ------------------------------------------------------------
# Loki and Tempo always run: the services write logs and spans to them from
# application code and would print connection errors without them. Grafana and
# Prometheus are opt-in:
#   docker compose --profile observability up -d
# Spans come from the hand-written TracingConfig class in each service, exported
# over OTLP/gRPC to Tempo. The endpoint is set in docker-compose.yml
# (NIGHTFLOW_TRACING_OTLP_GRPC_ENDPOINT); there is no on/off switch.
GRAFANA_USER=admin
GRAFANA_PASSWORD=password

# --- resources ----------------------------------------------------------------
# Memory ceiling per application container. The JVM sizes its heap from this
# (-XX:MaxRAMPercentage=75). 11 services x 512m needs roughly 6 GB for the
# services alone, plus about 2 GB for the datastores.
SERVICE_MEM_LIMIT=512m
