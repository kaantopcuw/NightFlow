# Copy to terraform.tfvars and adjust. Nothing here is a secret - AWS
# credentials come from the environment or from the AWS CLI profile, never from
# this file.
#
#   cp terraform.tfvars.example terraform.tfvars

aws_region  = "eu-central-1"
project     = "nightflow"
environment = "dev"

# Networking
vpc_cidr                = "10.0.0.0/16"
availability_zone_count = 3
# One NAT gateway instead of three: roughly a third of the cost, and a single
# point of failure. Set to false for production.
single_nat_gateway = true

# Cluster
kubernetes_version = "1.31"
# Restrict this to your office/VPN egress addresses instead of the world.
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]

# Nodes
node_instance_types     = ["t3.large"]
node_group_min_size     = 2
node_group_max_size     = 5
node_group_desired_size = 3

# Registries
ecr_image_retention_count = 20

tags = {
  Owner = "your-name-here"
}
