# Copy to `.env.local` and adjust. No secrets belong in this file: the panel
# only ever holds a JWT that the user obtained by logging in.

# Prefix put in front of every API path by the browser client.
# Leave empty so requests stay same-origin (`/api/...`) and are forwarded by the
# Vite dev proxy (development) or by whatever serves the built assets (production).
VITE_API_BASE_URL=

# Where the Vite dev server proxies `/api` to. This is the NightFlow
# gateway-service, the single entry point for all clients. `npm run test:live`
# calls this address directly (it runs in Node, so there is no proxy and no CORS).
VITE_GATEWAY_URL=http://localhost:8080

# Account `npm run test:live` signs in with. A disposable test user, never a
# real one: the live suite is read-mostly but it does sign in for real.
VITE_LIVE_EMAIL=reviewbot@example.com
VITE_LIVE_PASSWORD=test1234

# "true" serves DTO-shaped mock data through MSW instead of calling the gateway,
# so the panel can be demoed without the 11-service backend running.
VITE_ENABLE_MOCKS=false
